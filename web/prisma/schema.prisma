// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  users     User[]
  projects  Project[]
  createdAt DateTime  @default(now())
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  role           String        @default("user")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  projects       Project[]
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  type           String        // "single_stand", "estate", etc.
  status         String
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  
  stand          Stand?
  documents      Document[]
  extractions    Extraction[]
  brief          Brief?
  constraints    Constraint[]
  concepts       Concept[]
  costEstimates  CostEstimate[]
  reports        Report[]
  aiJobs         AIJob[]
  
  createdAt      DateTime      @default(now())
}

model Stand {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  erfNumber   String?
  boundaries  Json?    // Placeholder for Milestone 1 (PostGIS deferred)
  slope       String?
  roadAccess  String?
}

model Document {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  name        String
  type        String          // "zoning", "survey", "guidelines"
  url         String
  status      String          // "uploaded", "processing", "extracted"
  chunks      DocumentChunk[]
  extractions Extraction[]
}

model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id])
  text           String
  pageRef        Int?
  classification String?
  // embedding   Unsupported("vector(1536)")? // pgvector, implemented later
}

model AIJob {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  documentId  String?
  type        String    // "extraction", "concept_generation"
  status      String    // "pending", "running", "completed", "failed"
  result      Json?
  errorLog    String?
  startedAt   DateTime?
  completedAt DateTime?
}

model Extraction {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  category    String   // "setback", "height", "coverage"
  value       String
  confidence  Float
  pageRefs    Json?
  verified    Boolean  @default(false)
}

model Brief {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  data        Json     // Stores room counts, style, budget, priorities
}

model Concept {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  name        String
  versions    ConceptVersion[]
}

model ConceptVersion {
  id          String   @id @default(uuid())
  conceptId   String
  concept     Concept  @relation(fields: [conceptId], references: [id])
  versionNum  Int
  rationale   String
  scores      Json     // Buildability, cost complexity, etc.
  visualUrl   String?  // URL to SVG/image
  createdAt   DateTime @default(now())
}

model CostEstimate {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  area        Float?
  ratePerM2   Float?
  multiplier  Float?
  totalRange  Json     // Min, Max
  assumptions Json
}

model Report {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  pdfUrl      String?
  status      String   // "generating", "ready"
  createdAt   DateTime @default(now())
}

model Constraint {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  type        String
  value       String
}
