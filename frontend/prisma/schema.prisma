// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  users     User[]
  projects  Project[]
  createdAt DateTime  @default(now())
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  role           String        @default("user")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  projects       Project[]
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  type           String        // "single_stand", "estate", etc.
  status         String
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  
  stand          Stand?
  documents      Document[]
  extractions    Extraction[]
  brief          Brief?
  constraints    Constraint[]
  concepts       Concept[]
  costEstimates  CostEstimate[]
  reports        Report[]
  aiJobs         AIJob[]
  
  createdAt      DateTime      @default(now())
}

model Stand {
  id                String   @id @default(uuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id])
  erfNumber         String?
  standArea         Float?
  standType         String?
  latitude          Float?
  longitude         Float?
  googlePinUrl      String?
  roadAccessSide    String?
  northDirection    String?
  northAngleDeg     Float?
  slopeCondition    String?
  viewDirection     String?
  privacyNotes      String?
  siteRisks         String?
  contourNotes      String?
  geometryJson      Json?
  sourceDocumentIds Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

model Document {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  name        String
  type        String          // "zoning", "survey", "guidelines"
  url         String
  status      String          // "uploaded", "processing", "extracted"
  chunks      DocumentChunk[]
  extractions Extraction[]
  aiJobs      AIJob[]
}

model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id])
  text           String
  pageRef        Int?
  classification String?
  // embedding   Unsupported("vector(1536)")? // pgvector, implemented later
}

model AIJob {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  type        String    // "extraction", "concept_generation"
  status      String    // "pending", "running", "completed", "failed"
  message     String?   // Real-time detailed progress status
  result      Json?
  errorLog    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Extraction {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  fieldKey    String   // e.g., 'max_height', 'street_building_line'
  label       String   // e.g., 'Maximum Height', 'Street Building Line'
  category    String   // e.g., 'zoning', 'setback', 'coverage'
  value       String   // e.g., '2', '3'
  unit        String?  // e.g., 'storeys', 'm', '%'
  sourceText  String   // Exact snippet from the document to prove the extraction
  confidence  Float
  pageRefs    Json?
  notes          String?  // Any LLM reasoning or condition
  verified       Boolean  @default(false)
  verifiedBy     String?
  verifiedAt     DateTime?
  rejected       Boolean  @default(false)
  rejectionReason String?
  editedValue    String?
  editedUnit     String?
  editedLabel    String?
  editedCategory String?
  editedAt       DateTime?
  constraint     Constraint?
}

model Brief {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  data        Json     // Stores room counts, style, budget, priorities
}

model Concept {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  name        String
  versions    ConceptVersion[]
}

model ConceptVersion {
  id          String   @id @default(uuid())
  conceptId   String
  concept     Concept  @relation(fields: [conceptId], references: [id])
  versionNum  Int
  rationale   String
  scores      Json     // Buildability, cost complexity, etc.
  visualUrl   String?  // URL to SVG/image
  data        Json?    // Detailed concept payload (MVP)
  createdAt   DateTime @default(now())
  costEstimate CostEstimate?
}

model CostEstimate {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  conceptVersionId String   @unique
  conceptVersion   ConceptVersion @relation(fields: [conceptVersionId], references: [id])
  area             Float?
  ratePerM2        Float?
  multiplier       Float?
  totalRange       Json     // Min, Max
  assumptions      Json
  data             Json?
}

model Report {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  pdfUrl      String?
  status      String   // "generating", "ready"
  createdAt   DateTime @default(now())
}

model Constraint {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  extractionId String?  @unique
  extraction   Extraction? @relation(fields: [extractionId], references: [id])
  type         String
  value        String
}
